FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

// OpenFOAM 13: foamRun replaces icoFoam/simpleFoam.
// The fluid solver module is specified here.
application     foamRun;

solvers
{
    fluid
    {
        solver          incompressibleFluid;
    }
}

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.5;
deltaT          0.005;
writeControl    timeStep;
writeInterval   20;
